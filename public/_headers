# Cloudflare static-asset headers (copied into the export by `expo export`).

# Content-hashed bundles, fonts and images: a new build gets new file names.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Met object ID snapshot (scripts/build-met-ids.mjs); fine to be a day stale.
/met-ids.json
  Cache-Control: public, max-age=86400
